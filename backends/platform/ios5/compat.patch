 int64 PosixIoStream::size() const {
+#ifdef IPHONE_IOS5
+	IOS5Metrics::FileScope trace("metadata", _traceName);
+#endif
 	int fd = fileno((FILE *)_handle);
 	if (fd == -1) {
 		return StdioStream::size();
 	}
 
 	// Using fstat to obtain the file size is generally faster than fseek / ftell
 	// because it does not affect the IO buffer.
 	struct stat st;
 	if (fstat(fd, &st) == -1) {
 		return StdioStream::size();
 	}
 
 	return st.st_size;
 }
+
+#ifdef IPHONE_IOS5
+StdioStream *PosixIoStream::makeTracedStream(const Common::String &path, StdioStream::WriteMode mode) {
+	IOS5Metrics::FileScope trace("open", path.c_str());
+	StdioStream *stream = StdioStream::makeFromPathHelper(path, mode, [](void *handle) -> StdioStream * {
+		return new PosixIoStream(handle);
+	});
+	if (stream) {
+		PosixIoStream *file = static_cast<PosixIoStream *>(stream);
+		const char *base = strrchr(path.c_str(), '/');
+		strncpy(file->_traceName, base ? base + 1 : path.c_str(), sizeof(file->_traceName) - 1);
+	}
+	return stream;
+}
+uint32 PosixIoStream::read(void *data, uint32 size) {
+	IOS5Metrics::FileScope trace("read", _traceName);
+	const uint32 result = StdioStream::read(data, size);
+	trace.bytes(result);
+	return result;
+}
+bool PosixIoStream::seek(int64 offset, int whence) {
+	IOS5Metrics::FileScope trace("seek", _traceName);
+	return StdioStream::seek(offset, whence);
+}
+#endif
