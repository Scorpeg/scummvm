+
+void IOS5TextureSurface::updateGLTexture() {
+	if (!_shared) { TextureSurface::updateGLTexture(); return; }
+
+
+	static IOS5Metrics::Metric publishMetric("shared_publish");
+	IOS5Metrics::Scope scope(publishMetric);
+	if (!ios5SharedPublish(_shared, _linear ? GL_LINEAR : GL_NEAREST))
+		error("iOS5 shared surface GPU publish failed");
+	_sharedGL.setSharedName(ios5SharedName(_shared), _sharedSurface.w, _sharedSurface.h, ios5SharedCoords(_shared));
+	clearDirty();
+}
