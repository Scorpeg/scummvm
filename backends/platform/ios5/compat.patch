+
+void IOS5TextureSurface::copyRectToTexture(uint x, uint y, uint w, uint h, const void *src, uint srcPitch) {
+	if (!_shared) { Surface::copyRectToTexture(x, y, w, h, src, srcPitch); return; }
+
+
+	static IOS5Metrics::Metric copyMetric("texture_copy");
+	IOS5Metrics::Scope scope(copyMetric, uint64_t(w) * h * _format.bytesPerPixel);
+	getSurface()->copyRectToSurface(src, srcPitch, x, y, w, h);
+	addDirtyArea(Common::Rect(x, y, x + w, y + h));
