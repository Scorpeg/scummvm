+void IOS5TextureSurface::releaseShared() {
+
+	_sharedGL.setSharedName(0, 1, 1, nullptr);
+	ios5SharedDestroy(_shared);
+	_shared = nullptr;
+	_sharedSurface.init(0, 0, 0, nullptr, _format);
