+
+void IOS5TextureSurface::allocate(uint width, uint height) {
+	if (_shared && width == (uint)_sharedSurface.w && height == (uint)_sharedSurface.h) return;
+	releaseShared();
+	_shared = ios5SharedCreate(width, height);
+	if (!_shared) {
+		TextureSurface::allocate(width, height);
+		return;
+	}
+	void *pixels; size_t pitch;
+	if (!ios5SharedLock(_shared, &pixels, &pitch)) error("iOS5 shared surface initial lock failed");
+	_sharedSurface.init(width, height, pitch, pixels, _format);
+	_sharedGL.setSharedName(ios5SharedName(_shared), width, height, ios5SharedCoords(_shared));
+	flagDirty();
+}
+
+Graphics::Surface *IOS5TextureSurface::getSurface() {
+	if (!_shared) return TextureSurface::getSurface();
+	void *pixels; size_t pitch;
+	if (!ios5SharedLock(_shared, &pixels, &pitch)) error("iOS5 shared surface CPU lock failed");
+	_sharedSurface.init(_sharedSurface.w, _sharedSurface.h, pitch, pixels, _format);
+	return &_sharedSurface;
+}
